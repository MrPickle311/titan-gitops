{
  "title": "Spring Boot Actuator UI",
  "uid": "actuator-ui-infinity",
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "1m",
  "panels": [
    {
      "type": "table",
      "title": "API Mappings",
      "datasource": {
        "type": "marcusolsson-json-datasource",
        "uid": "json-api-export-batch"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "json-api-export-batch"
          },
          "urlPath": "/actuator/mappings",
          "method": "GET",
          "jsonPath": "$.contexts.application.mappings.dispatcherServlets.dispatcherServlet[*]",
          "fields": [
            {
              "jsonPath": "$.predicate",
              "name": "Route",
              "type": "string"
            },
            {
              "jsonPath": "$.handler",
              "name": "Handler",
              "type": "string"
            },
            {
              "jsonPath": "$.details.handlerMethod.className",
              "name": "Class",
              "type": "string"
            },
            {
              "jsonPath": "$.details.handlerMethod.name",
              "name": "Method",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "type": "table",
      "title": "Application Beans",
      "datasource": {
        "type": "marcusolsson-json-datasource",
        "uid": "json-api-export-batch"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "json-api-export-batch"
          },
          "urlPath": "/actuator/beans",
          "method": "GET",
          "jsonPath": "$.contexts.application.beans.*",
          "fields": [
            {
              "jsonPath": "$.type",
              "name": "Class",
              "type": "string"
            },
            {
              "jsonPath": "$.scope",
              "name": "Scope",
              "type": "string"
            },
            {
              "jsonPath": "$.resource",
              "name": "Resource",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "type": "table",
      "title": "Environment Variables",
      "datasource": {
        "type": "marcusolsson-json-datasource",
        "uid": "json-api-export-batch"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "json-api-export-batch"
          },
          "urlPath": "/actuator/env",
          "method": "GET",
          "jsonPath": "$.propertySources[*]",
          "fields": [
            {
              "jsonPath": "$.name",
              "name": "Property Source",
              "type": "string"
            }
          ]
        }
      ]
    }
  ]
}
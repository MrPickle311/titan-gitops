{
  "title": "Spring Boot Actuator UI",
  "uid": "actuator-ui-infinity",
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service_url",
        "type": "custom",
        "query": "http://payment-service.applications.svc.cluster.local:8080,http://ledger-service.applications.svc.cluster.local:8082,http://wallet-service.applications.svc.cluster.local:8081,http://export-batch-service.applications.svc.cluster.local:8083",
        "current": {
          "text": "http://export-batch-service.applications.svc.cluster.local:8083",
          "value": "http://export-batch-service.applications.svc.cluster.local:8083"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "API Mappings ($service_url)",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "parser": "JSONata",
          "source": "url",
          "format": "table",
          "url": "$service_url/actuator/mappings",
          "root_selector": "contexts.*.mappings.dispatcherServlets.dispatcherServlet",
          "columns": [
            {
              "selector": "predicate",
              "text": "Route",
              "type": "string"
            },
            {
              "selector": "handler",
              "text": "Handler",
              "type": "string"
            },
            {
              "selector": "details.handlerMethod.className",
              "text": "Class",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "type": "table",
      "title": "Application Beans ($service_url)",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "parser": "JSONata",
          "source": "url",
          "format": "table",
          "url": "$service_url/actuator/beans",
          "root_selector": "$each(contexts.*.beans, function($v, $k) { { 'Bean Name': $k, 'Class': $v.type, 'Scope': $v.scope, 'Resource': $v.resource } })",
          "columns": [
            {
              "selector": "Bean Name",
              "text": "Bean Name",
              "type": "string"
            },
            {
              "selector": "Class",
              "text": "Class",
              "type": "string"
            },
            {
              "selector": "Scope",
              "text": "Scope",
              "type": "string"
            },
            {
              "selector": "Resource",
              "text": "Resource",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "type": "table",
      "title": "Environment Variables ($service_url)",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "parser": "JSONata",
          "source": "url",
          "format": "table",
          "url": "$service_url/actuator/env",
          "root_selector": "propertySources.($name := name; $each(properties, function($v, $k) { { 'Property Source': $name, 'Property': $k, 'Value': $v.value } }))",
          "columns": [
            {
              "selector": "Property Source",
              "text": "Property Source",
              "type": "string"
            },
            {
              "selector": "Property",
              "text": "Property",
              "type": "string"
            },
            {
              "selector": "Value",
              "text": "Value",
              "type": "string"
            }
          ]
        }
      ]
    }
  ]
}